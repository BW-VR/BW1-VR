ntdll: No EXT2_IOC_GETFLAGS on a FUSE file system.

The FUSE daemon of Android 14 (MediaProvider with fuse-bpf) stops on
FS_IOC_GETFLAGS of a directory of Android/data ("Check failed:
active_nodes_.find(node)" in pf_opendir), and the app loses the shared
storage. get_dir_case_sensitivity_stat makes this ioctl for each
directory that Wine looks into. A FUSE file system has no casefold
flag, so the check of .ciopfs is the whole check there.

--- a/dlls/ntdll/unix/file.c	2026-10-23 10:55:35.863360208 +0200
+++ b/dlls/ntdll/unix/file.c	2026-10-23 10:55:35.863795514 +0200
@@ -1312,13 +1312,17 @@
     if ((fd = openat( root_fd, dir, O_RDONLY | O_NONBLOCK )) == -1)
         return TRUE;
 
-    if (ioctl( fd, EXT2_IOC_GETFLAGS, &flags ) != -1 && (flags & EXT4_CASEFOLD_FL))
+    /* No EXT2_IOC_GETFLAGS on FUSE: the FUSE daemon of Android (MediaProvider
+     * with fuse-bpf) stops on this ioctl of a directory of Android/data, and
+     * a FUSE file system has no casefold flag. */
+    if (fstatfs( fd, &stfs ) == 0 &&
+        stfs.f_type == 0x65735546 /* FUSE_SUPER_MAGIC */)
     {
-        sens = FALSE;
+        /* CIOPFS is case insensitive.  Instead of parsing mtab to discover
+         * if the FUSE FS is CIOPFS, look for .ciopfs in the dir. */
+        if (fstatat( fd, ".ciopfs", &st, AT_NO_AUTOMOUNT ) == 0) sens = FALSE;
     }
-    else if (fstatfs( fd, &stfs ) == 0 &&                          /* CIOPFS is case insensitive.  Instead of */
-             stfs.f_type == 0x65735546 /* FUSE_SUPER_MAGIC */ &&   /* parsing mtab to discover if the FUSE FS */
-             fstatat( fd, ".ciopfs", &st, AT_NO_AUTOMOUNT ) == 0)  /* is CIOPFS, look for .ciopfs in the dir. */
+    else if (ioctl( fd, EXT2_IOC_GETFLAGS, &flags ) != -1 && (flags & EXT4_CASEFOLD_FL))
     {
         sens = FALSE;
     }
