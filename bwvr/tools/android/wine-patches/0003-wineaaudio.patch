+static UINT midi_no_device(UINT msg)
+{
+    switch (msg)
+    {
+    case DRVM_INIT:
+    case DRVM_EXIT:
+    case DRVM_ENABLE:
+    case DRVM_DISABLE:
+        return MMSYSERR_NOERROR;
+    case MODM_GETNUMDEVS:
+    case MIDM_GETNUMDEVS:
+        return 0;
+    }
+    return MMSYSERR_BADDEVICEID;
+}
