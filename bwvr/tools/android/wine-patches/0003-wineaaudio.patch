+static NTSTATUS aaudio_midi_out_message(void *args)
+{
+    struct midi_out_message_params *params = args;
+
+    params->notify->send_notify = FALSE;
+    *params->err = midi_no_device(params->msg);
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS aaudio_midi_in_message(void *args)
+{
+    struct midi_in_message_params *params = args;
+
+    params->notify->send_notify = FALSE;
+    *params->err = midi_no_device(params->msg);
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS aaudio_midi_notify_wait(void *args)
+{
+    struct midi_notify_wait_params *params = args;
+
+    /* No device sends a notification: the thread of mmdevapi ends. */
+    params->notify->send_notify = FALSE;
+    *params->quit = TRUE;
+    return STATUS_SUCCESS;
+}
+
+/* No aux device. */
+static NTSTATUS aaudio_aux_message(void *args)
+{
+    struct aux_message_params *params = args;
+
+    switch (params->msg)
+    {
+    case DRVM_INIT:
+    case DRVM_EXIT:
+    case DRVM_ENABLE:
+    case DRVM_DISABLE:
+    case AUXDM_GETNUMDEVS:
+        *params->err = 0;
+        break;
+    default:
+        *params->err = MMSYSERR_NOTSUPPORTED;
+        break;
+    }
+
+    return STATUS_SUCCESS;
+}
