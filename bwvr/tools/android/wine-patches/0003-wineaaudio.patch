+{
+    struct release_capture_buffer_params *params = args;
+
+    params->result = AUDCLNT_E_WRONG_ENDPOINT_TYPE;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS aaudio_is_format_supported(void *args)
+{
+    struct is_format_supported_params *params = args;
+
+    if(params->flow != eRender){
+        params->result = AUDCLNT_E_DEVICE_INVALIDATED;
+        return STATUS_SUCCESS;
+    }
+    params->result = check_format(params->share, params->fmt_in);
+
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS aaudio_get_mix_format(void *args)
+{
+    struct get_mix_format_params *params = args;
+    WAVEFORMATEXTENSIBLE *fmt = params->fmt;
+
+    if(params->flow != eRender){
+        params->result = params->flow == eCapture ? AUDCLNT_E_DEVICE_INVALIDATED : E_UNEXPECTED;
+        return STATUS_SUCCESS;
+    }
+
+    /* The rate of the device and 32 bit float, so AAudio converts
+     * nothing for the mix of dsound. */
+    fmt->Format.wFormatTag = WAVE_FORMAT_EXTENSIBLE;
+    fmt->Format.wBitsPerSample = 32;
+    fmt->SubFormat = KSDATAFORMAT_SUBTYPE_IEEE_FLOAT;
+    fmt->Format.nChannels = 2;
+    fmt->Format.nSamplesPerSec = get_native_rate(NULL);
+    fmt->dwChannelMask = get_channel_mask(fmt->Format.nChannels);
+    fmt->Format.nBlockAlign = (fmt->Format.wBitsPerSample *
+            fmt->Format.nChannels) / 8;
+    fmt->Format.nAvgBytesPerSec = fmt->Format.nSamplesPerSec *
+        fmt->Format.nBlockAlign;
+    fmt->Samples.wValidBitsPerSample = fmt->Format.wBitsPerSample;
+    fmt->Format.cbSize = sizeof(WAVEFORMATEXTENSIBLE) - sizeof(WAVEFORMATEX);
+
+    params->result = S_OK;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS aaudio_get_device_period(void *args)
+{
+    struct get_device_period_params *params = args;
+
+    REFERENCE_TIME burst_time = 0;
+
+    /* A period of at least one burst of the device. AAudio of the mode
+     * none (an AudioTrack) plays a stream only when its buffer has the
+     * frames of its start threshold, at least one burst, and the program
+     * keeps about 3 periods in the buffer: with a period shorter than a
+     * burst (an emulator has bursts of 45 ms) the stream does not start. */
+    get_native_rate(&burst_time);
+    burst_time = (burst_time + 9999) / 10000 * 10000;
+
+    if (params->def_period)
+        *params->def_period = max(def_period, burst_time);
+    if (params->min_period)
+        *params->min_period = max(min_period, burst_time);
+
+    params->result = S_OK;
+
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS aaudio_get_buffer_size(void *args)
+{
+    struct get_buffer_size_params *params = args;
+    struct aaudio_stream *stream = handle_get_stream(params->stream);
+
+    aaudio_lock(stream);
+
+    *params->frames = stream->bufsize_frames;
+
+    return aaudio_unlock_result(stream, &params->result, S_OK);
+}
+
+static NTSTATUS aaudio_get_latency(void *args)
+{
+    struct get_latency_params *params = args;
+    struct aaudio_stream *stream = handle_get_stream(params->stream);
+
+    aaudio_lock(stream);
+
+    /* pretend we process audio in Period chunks, so max latency includes
+     * the period time.  Some native machines add .6666ms in shared mode. */
+    *params->latency = stream->period + 6666;
+
+    return aaudio_unlock_result(stream, &params->result, S_OK);
+}
+
+static NTSTATUS aaudio_get_current_padding(void *args)
+{
+    struct get_current_padding_params *params = args;
+    struct aaudio_stream *stream = handle_get_stream(params->stream);
+
+    aaudio_lock(stream);
+
+    *params->padding = stream->held_frames;
+
+    return aaudio_unlock_result(stream, &params->result, S_OK);
+}
+
+static NTSTATUS aaudio_get_next_packet_size(void *args)
+{
+    struct get_next_packet_size_params *params = args;
+    struct aaudio_stream *stream = handle_get_stream(params->stream);
+    UINT32 *frames = params->frames;
+
+    aaudio_lock(stream);
+
+    *frames = stream->held_frames < stream->period_frames ? 0 : stream->period_frames;
+
+    return aaudio_unlock_result(stream, &params->result, S_OK);
+}
+
+static NTSTATUS aaudio_get_frequency(void *args)
+{
+    struct get_frequency_params *params = args;
+    struct aaudio_stream *stream = handle_get_stream(params->stream);
+    UINT64 *freq = params->freq;
+
+    aaudio_lock(stream);
+
+    if(stream->share == AUDCLNT_SHAREMODE_SHARED)
+        *freq = (UINT64)stream->fmt->nSamplesPerSec * stream->fmt->nBlockAlign;
+    else
+        *freq = stream->fmt->nSamplesPerSec;
+
+    return aaudio_unlock_result(stream, &params->result, S_OK);
+}
+
+static NTSTATUS aaudio_get_position(void *args)
+{
+    struct get_position_params *params = args;
+    struct aaudio_stream *stream = handle_get_stream(params->stream);
+    UINT64 *pos = params->pos, *qpctime = params->qpctime;
+
+    if (params->device) {
+        FIXME("Device position reporting not implemented\n");
+        params->result = E_NOTIMPL;
+        return STATUS_SUCCESS;
+    }
+
+    aaudio_lock(stream);
+
+    *pos = stream->written_frames - stream->held_frames;
+    if(*pos < stream->last_pos_frames)
+        *pos = stream->last_pos_frames;
+
+    stream->last_pos_frames = *pos;
+
+    TRACE("returning: %s\n", wine_dbgstr_longlong(*pos));
+    if(stream->share == AUDCLNT_SHAREMODE_SHARED)
+        *pos *= stream->fmt->nBlockAlign;
+
+    if(qpctime){
+        LARGE_INTEGER stamp, freq;
+        NtQueryPerformanceCounter(&stamp, &freq);
+        *qpctime = (stamp.QuadPart * (INT64)10000000) / freq.QuadPart;
+    }
+
+    return aaudio_unlock_result(stream, &params->result, S_OK);
+}
+
+static NTSTATUS aaudio_set_volumes(void *args)
+{
+    struct set_volumes_params *params = args;
+    struct aaudio_stream *stream = handle_get_stream(params->stream);
+    UINT16 i;
+
+    aaudio_lock(stream);
+    stream->mute = !params->master_volume;
+    stream->unity = TRUE;
+    for (i = 0; i < stream->fmt->nChannels && i < ARRAY_SIZE(stream->gains); ++i) {
+        stream->gains[i] = params->master_volume * params->volumes[i] * params->session_volumes[i];
+        if (stream->gains[i] != 1.0f)
+            stream->unity = FALSE;
+    }
+    aaudio_unlock(stream);
+
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS aaudio_set_event_handle(void *args)
+{
+    struct set_event_handle_params *params = args;
+    struct aaudio_stream *stream = handle_get_stream(params->stream);
+
+    aaudio_lock(stream);
+
+    if(!(stream->flags & AUDCLNT_STREAMFLAGS_EVENTCALLBACK))
+        return aaudio_unlock_result(stream, &params->result, AUDCLNT_E_EVENTHANDLE_NOT_EXPECTED);
+
+    if (stream->event){
+        FIXME("called twice\n");
+        return aaudio_unlock_result(stream, &params->result, HRESULT_FROM_WIN32(ERROR_INVALID_NAME));
+    }
+
+    stream->event = params->event;
+
+    return aaudio_unlock_result(stream, &params->result, S_OK);
+}
+
+static NTSTATUS aaudio_is_started(void *args)
+{
+    struct is_started_params *params = args;
+    struct aaudio_stream *stream = handle_get_stream(params->stream);
+
+    aaudio_lock(stream);
+
+    return aaudio_unlock_result(stream, &params->result, stream->playing ? S_OK : S_FALSE);
+}
