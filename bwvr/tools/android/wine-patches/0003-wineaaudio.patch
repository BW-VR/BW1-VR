+struct aaudio_stream
+{
+    WAVEFORMATEX *fmt;
+    EDataFlow flow;
+    UINT flags;
+    AUDCLNT_SHAREMODE share;
+    HANDLE event;
+
+    AAudioStream *aa;
+    aaudio_format_t aa_format;
+    aaudio_performance_mode_t aa_mode;
+    int32_t aa_burst, aa_bufsize, aa_capacity;
+
+    BOOL playing, mute, please_quit, unity, convert_format, latency_logged;
+    UINT64 written_frames, last_pos_frames;
+    UINT32 period_frames, bufsize_frames, held_frames, tmp_buffer_frames;
+    UINT32 lcl_offs_frames; /* offs into local_buffer where valid data starts */
+    REFERENCE_TIME period;
+    float gains[2];
+    int32_t xruns_logged;
+    UINT64 log_check_frames, silent_frames, silent_logged;
+
+    BYTE *local_buffer, *tmp_buffer;
+    INT32 getbuf_last; /* <0 when using tmp_buffer */
+
+    pthread_mutex_t lock;
+};
